{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "0b331e7a054a4771b97912a3664e6f63",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "HairGlow (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -500,
            "y": 300,
            "width": 200,
            "height": 120
        }
    },
    "m_Slots": [
        {
            "m_Id": "81ec89420a3e4bd590e5e0a7870741fe"
        },
        {
            "m_Id": "5ec16026b6554715bde7560fdbb489d1"
        },
        {
            "m_Id": "5b312454f5484953b95b587d2f3348a9"
        },
        {
            "m_Id": "d82e9b186ea540cea59036748eb157c2"
        },
        {
            "m_Id": "d8afecfed6934213879d4a2d21940b78"
        },
        {
            "m_Id": "beeabf4a79c2444b9d211e0ae66f2ae1"
        },
        {
            "m_Id": "2ebc1ae211944c6db0abba496ded8c46"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "HairGlow",
    "m_FunctionSource": "",
    "m_FunctionBody": "// Isik vurmus gibi degil, sacin kendisi parliyormus gibi: yumusak, yone bagimsiz ic parilti.\n// Saci kendi dokusuyla (Albedo) altin tona karistirir; kenarlarda hafif halo; cok yavas nefes gibi soluk dalga.\nfloat3 n = normalize(Normal);\nfloat3 v = normalize(View);\nfloat rim = pow(1.0 - saturate(dot(n, v)), 1.6);\nfloat body = 0.75 + 0.9 * rim;\nfloat breathe = 0.92 + 0.08 * sin(_TimeParameters.x * 1.4 + Pos.y * 3.0);\nfloat lum = dot(Albedo.rgb, float3(0.299, 0.587, 0.114));\nfloat3 tint = lerp(GlowColor.rgb, Albedo.rgb * float3(1.25, 0.8, 0.3), 0.35);\nfloat strand = 0.3 + 1.0 * lum * lum;\nOut = tint * strand * body * breathe * Glow * 0.7;"
}

