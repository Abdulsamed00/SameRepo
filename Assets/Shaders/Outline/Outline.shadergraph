{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "eae190fefdd841ceb45938c6cc34799a",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "OutlineHull (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -600,
            "y": -300,
            "width": 200,
            "height": 120
        }
    },
    "m_Slots": [
        {
            "m_Id": "012c2231ecfd43e2b70296dfc929e9b7"
        },
        {
            "m_Id": "a0f0edcad009482888a5d286564f3af9"
        },
        {
            "m_Id": "d1da559dcd9b4a0b9b86018adde96b77"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "OutlineHull",
    "m_FunctionSource": "",
    "m_FunctionBody": "// Ters kabuk (inverted hull): kutunun merkezinden disari, her eksende ayni dunya kalinliginda sisirilir.\n// Nesne olcegi bolunur: olcekli kupte (cuzdan) kenar her yonde Width metre kalinlikta kalir.\nfloat4x4 m = GetObjectToWorldMatrix();\nfloat3 s = float3(length(m._m00_m10_m20), length(m._m01_m11_m21), length(m._m02_m12_m22));\nOut = Position + sign(Position) * Width / max(s, 1e-5);"
}

